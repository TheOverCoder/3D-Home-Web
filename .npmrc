# Every install is pinned to its exact version and runs no package's install script (update-v1/REUSE.md).
# Checked 2026-11-18: no installed package has an install script. The lockfile's only one is fsevents (macOS only,
# optional, Vite's): its package ships its built binary, so a Mac does without its `node-gyp rebuild`.
# Scripts called by name still run (`npm run check`, `npm run build`); only lifecycle hooks are skipped.
save-exact=true
ignore-scripts=true
