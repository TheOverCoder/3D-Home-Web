{
  "name": "3d-home-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lab": "vite --config vite.lab.config.ts",
    "lab:build": "vite build --config vite.lab.config.ts && node scripts/lab-finish.mjs",
    "typecheck": "tsc --noEmit",
    "assets:hdri": "node scripts/fetch-polyhaven.mjs",
    "assets:optimize": "node scripts/optimize-models.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --grep-invert @boot",
    "test:e2e:core": "playwright test --grep-invert @full",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"lab/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"lab/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\"",
    "check": "tsc --noEmit && oxlint && vitest run && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@pmndrs/assets": "^1.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.2.0",
    "ecctrl": "^2.0.2",
    "eruda": "3.4.3",
    "lil-gui": "0.21.0",
    "manifold-3d": "3.5.4",
    "meshoptimizer": "1.1.1",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three.quarks": "0.17.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "A walkable 3D house with interactive screens in every room"
}
